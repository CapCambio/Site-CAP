
# Configurações do ambiente
NODE_ENV=development
PORT=5000

# Configurações da aplicação
APP_NAME="CAP Cotações"
APP_URL="http://localhost:5000"

# Configuração de CDN para assets estáticos (opcional)
# Exemplo: CDN_URL=https://cdn.example.com/
# Deixe vazio ou não defina para usar caminho relativo padrão
CDN_URL=

# Configurações de e-mail (obrigatórias para envio de e-mails)
EMAIL_ENABLED=true
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=seu-usuario-smtp-brevo
EMAIL_PASS=sua-chave-smtp-brevo
EMAIL_FROM="CAP Câmbio <no-reply@capcambio.com>"
EMAIL_SECURE=false  # true para porta 465, false para outras portas

# Configurações de taxa de envio
EMAIL_RETRY_ATTEMPTS=3     # Número de tentativas de envio
EMAIL_RETRY_DELAY_MS=5000  # Tempo entre tentativas em milissegundos
EMAIL_RATE_LIMIT=100       # Limite de e-mails por hora por usuário

# Configurações VAPID para notificações push (obrigatórias)
VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
VAPID_EMAIL=seu-email@exemplo.com

# Configurações de scraping (opcional)
SCRAPING_INTERVAL=300000  # 5 minutos

# Configurações de segurança
SESSION_SECRET=seu-segredo-seguro

# Senhas de administradores (JSON). Chaves devem ser emails em minúsculo.
# Exemplo: {"admin@exemplo.com":"uma-senha-forte"}
ADMIN_PASSWORDS_JSON={"admin@exemplo.com":"uma-senha-forte"}

# Configurações de log
LOG_LEVEL=info  # debug, info, warn, error
