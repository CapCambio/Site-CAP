import {
  users, currencies, currencyHistory,
  type User, type InsertUser,
  type Currency, type InsertCurrency,
  type CurrencyHistory, type InsertCurrencyHistory
} from "@shared/schema";
import { db } from "./db";
import { eq, and, not, lte, gte, desc, sql } from "drizzle-orm";

export interface IStorage {
  getUser(id: number): Promise<User | undefined>;
  getUserByUsername(username: string): Promise<User | undefined>;
  createUser(user: InsertUser): Promise<User>;
  
  // Currency operations
  getAllCurrencies(): Promise<Currency[]>;
  getCurrencyByCode(code: string): Promise<Currency | undefined>;
  upsertCurrency(currency: InsertCurrency): Promise<Currency>;

  // Currency history operations
  getCurrencyHistory(code: string, startDate?: Date, endDate?: Date): Promise<CurrencyHistory[]>;
  addCurrencyHistory(history: InsertCurrencyHistory): Promise<CurrencyHistory>;
  cleanupOldHistory(olderThan: Date): Promise<number>;
}

export class DatabaseStorage implements IStorage {
  async getUser(id: number): Promise<User | undefined> {
    const [user] = await db.select().from(users).where(eq(users.id, id));
    return user;
  }

  async getUserByUsername(username: string): Promise<User | undefined> {
    const [user] = await db.select().from(users).where(eq(users.username, username));
    return user;
  }

  async createUser(insertUser: InsertUser): Promise<User> {
    const [user] = await db
      .insert(users)
      .values(insertUser)
      .returning();
    return user;
  }

  async getAllCurrencies(): Promise<Currency[]> {
    // Retorna ordenado pelo display_order
    return db
      .select()
      .from(currencies)
      .orderBy(currencies.displayOrder);
  }

  async getCurrencyByCode(code: string): Promise<Currency | undefined> {
    const [currency] = await db
      .select()
      .from(currencies)
      .where(eq(currencies.code, code));
    
    return currency;
  }

  async upsertCurrency(insertCurrency: InsertCurrency): Promise<Currency> {
    // Verifica se a moeda já existe
    const existingCurrency = await this.getCurrencyByCode(insertCurrency.code);
    
    if (existingCurrency) {
      // Atualiza a moeda existente
      const [updatedCurrency] = await db
        .update(currencies)
        .set(insertCurrency)
        .where(eq(currencies.id, existingCurrency.id))
        .returning();
      
      return updatedCurrency;
    } else {
      // Cria uma nova moeda
      const [newCurrency] = await db
        .insert(currencies)
        .values(insertCurrency)
        .returning();
      
      return newCurrency;
    }
  }

  async getCurrencyHistory(code: string, startDate?: Date, endDate?: Date): Promise<CurrencyHistory[]> {
    let query = db.select().from(currencyHistory).where(eq(currencyHistory.code, code));
    
    if (startDate) {
      query = query.where(gte(currencyHistory.timestamp, startDate));
    }
    
    if (endDate) {
      query = query.where(lte(currencyHistory.timestamp, endDate));
    }
    
    return query.orderBy(desc(currencyHistory.timestamp));
  }

  async addCurrencyHistory(insertHistory: InsertCurrencyHistory): Promise<CurrencyHistory> {
    const [history] = await db
      .insert(currencyHistory)
      .values(insertHistory)
      .returning();
    
    return history;
  }

  async cleanupOldHistory(olderThan: Date): Promise<number> {
    const result = await db
      .delete(currencyHistory)
      .where(lte(currencyHistory.timestamp, olderThan))
      .returning();
    
    return result.length;
  }

  // Método específico para obter o último registro de histórico de uma moeda
  async getLastCurrencyHistory(code: string): Promise<CurrencyHistory | undefined> {
    const [history] = await db
      .select()
      .from(currencyHistory)
      .where(eq(currencyHistory.code, code))
      .orderBy(desc(currencyHistory.timestamp))
      .limit(1);
    
    return history;
  }

  // Método CORRIGIDO para buscar a cotação anterior para cálculo de variação
  async getPreviousDifferentPrice(code: string, currentPrice: number): Promise<CurrencyHistory | undefined> {
    try {
      // Busca os registros mais recentes primeiro, até encontrar um com preço diferente
      const results = await db.execute(sql.raw(`
        WITH PriceChanges AS (
          SELECT 
            id, 
            code, 
            buy_price, 
            sell_price, 
            timestamp,
            LAG(sell_price) OVER (PARTITION BY code ORDER BY timestamp DESC) as prev_price
          FROM currency_history
          WHERE code = '${code}'
          ORDER BY timestamp DESC
          LIMIT 500
        )
        SELECT * FROM PriceChanges
        WHERE sell_price <> ${currentPrice}
        ORDER BY timestamp DESC
        LIMIT 1
      `));
      
      if (results.rows && results.rows.length > 0) {
        const row = results.rows[0];
        return {
          id: row.id,
          code: row.code,
          buyPrice: row.buy_price,
          sellPrice: row.sell_price,
          timestamp: new Date(row.timestamp)
        };
      }
      
      // Se não encontrar preço diferente, usa o registro mais antigo
      const [oldestHistory] = await db
        .select()
        .from(currencyHistory)
        .where(eq(currencyHistory.code, code))
        .orderBy(currencyHistory.timestamp)
        .limit(1);
        
      return oldestHistory;
    } catch (error) {
      console.error("Erro buscando preço anterior:", error);
      return undefined;
    }
  }

  // Método para buscar todos os registros de preços anteriores para análise
  async getAllPreviousPrices(code: string, limit: number = 100): Promise<CurrencyHistory[]> {
    return db
      .select()
      .from(currencyHistory)
      .where(eq(currencyHistory.code, code))
      .orderBy(desc(currencyHistory.timestamp))
      .limit(limit);
  }
}

export const storage = new DatabaseStorage();